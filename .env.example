# Copy this file to .env and fill in your own values. Never commit .env.

# --- Data and chunking ---
DATA_DIR=data/raw
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# --- Embedding model (changing it requires: python src/ingest.py --reset) ---
# Alternative, lighter: EMBED_MODEL=intfloat/multilingual-e5-small with EMBED_DIM=384
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024
EMBED_BATCH_SIZE=32
EMBED_MAX_LENGTH=512

# --- PostgreSQL / pgvector ---
PG_HOST=localhost
PG_PORT=5432
PG_USER=<your_user>
PG_PASSWORD=<your_password>
PG_DB=<your_database>
PG_TABLE=chunks

# --- LLM (Google Gemini API) ---
# Get a key on https://aistudio.google.com/apikey ; never commit it.
GEMINI_API_KEY=<your_gemini_api_key>
LLM_MODEL=gemini-3.8-flash
# LLM_TEMPERATURE=0.0
# LLM_MAX_TOKENS=2048
