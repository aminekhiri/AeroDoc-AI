# Copy this file to .env and fill in your own values. Never commit .env.

# --- Data and chunking ---
DATA_DIR=data/raw
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# --- Embedding model (changing it requires: python src/ingest.py --reset) ---
EMBED_MODEL=intfloat/multilingual-e5-small
EMBED_DIM=384
EMBED_BATCH_SIZE=32
EMBED_MAX_LENGTH=512

# --- PostgreSQL / pgvector ---
PG_HOST=localhost
PG_PORT=5432
PG_USER=<your_user>
PG_PASSWORD=<your_password>
PG_DB=<your_database>
PG_TABLE=chunks
